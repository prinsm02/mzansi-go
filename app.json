{
  "expo": {
    "name": "Mzansi Go",
    "slug": "iron-man-tracker",
    "version": "1.1.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.prins.ironmantracker",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Mzansi Go records your run, ride or swim route while the screen is locked.",
          "locationWhenInUsePermission": "Mzansi Go uses your location to record your route.",
          "isIosBackgroundLocationEnabled": true,
          "motionUsagePermission": "Mzansi Go counts your steps to show your running cadence."
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      "expo-build-properties",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Mzansi Go uses a photo you choose as your profile picture. It stays on your phone.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "backgroundColor": "#0d0d0d",
          "resizeMode": "contain"
        }
      ]
    ],
    "backgroundColor": "#0B0B0D"
  }
}
